# Environment Variables Template
# Copy this file to .env and configure credentials for REAL data mode.

DATA_MODE=DEMO   # Options: DEMO, REAL

# India Meteorological Department (IMD) Credentials
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_RADAR_ENDPOINT=/radar/v1/reflectivity
IMD_LIGHTNING_ENDPOINT=/lightning/v1/strikes

# Copernicus Climate Data Store (CDS) Credentials for ERA5 Reanalysis
ERA5_CDS_URL=https://cds.climate.copernicus.eu/api/v2
ERA5_CDS_KEY=

# Local Data Root Path (for offline raster/event file ingestion)
DATA_ROOT=./data/raw
